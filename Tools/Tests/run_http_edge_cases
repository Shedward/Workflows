#!/usr/bin/env bash
set -euo pipefail

. "$(dirname "$0")/../Lib/request.sh"

# Helper: assert that a raw curl request returns HTTP 2xx
assert_http_ok() {
  local method="$1"
  local path="$2"
  local http_code
  http_code=$(curl -sS -o /dev/null -w "%{http_code}" -X "$method" "${BASE}${path}")
  if [[ "$http_code" -ge 400 ]]; then
    echo "Expected 2xx for $method $path, got $http_code" >&2
    exit 1
  fi
}

# Helper: assert that a raw curl request returns HTTP 4xx/5xx
assert_http_error() {
  local method="$1"
  local path="$2"
  local http_code
  http_code=$(curl -sS -o /dev/null -w "%{http_code}" -X "$method" "${BASE}${path}")
  if [[ "$http_code" -lt 400 ]]; then
    echo "Expected 4xx/5xx for $method $path, got $http_code" >&2
    exit 1
  fi
}

main() {
  # Health endpoint returns 200
  assert_http_ok GET "/health"

  # Nonexistent path returns error
  assert_http_error GET "/nonexistent-path"

  # POST to GET-only endpoint returns error
  assert_http_error POST "/workflows"

  # DELETE on instances endpoint returns error
  assert_http_error DELETE "/workflowInstances"

  # A ?timeout= the server cannot sleep for must not take it down. Values that
  # are not finite numbers used to trap inside Task.sleep a moment after the
  # response was sent, killing the process.
  local value
  for value in nan inf -inf 1e30 -1 abc; do
    request POST "/workflowInstances?timeout=$value" '{"workflowId":"SimpleWorkflow"}' >/dev/null
  done
  sleep 1
  assert_http_ok GET "/health"

  # Success responses say what they contain.
  local content_type
  content_type="$(curl -sS -D - -o /dev/null "${BASE}/workflows" | tr -d '\r' | grep -i '^content-type:' || true)"
  if [[ "$content_type" != *"application/json"* ]]; then
    echo "Expected application/json content type on GET /workflows, got '${content_type:-none}'" >&2
    exit 1
  fi

  # An unknown workflow is the same ErrorResponse on every endpoint, the graph one included.
  local body
  for path in "/workflows/NoSuchWorkflow/graph" "/workflows/NoSuchWorkflow/starting" "/workflowInstances/no-such-id"; do
    body="$(curl -sS "${BASE}${path}")"
    if ! jq -e '.userDescription and .debugDescription' <<<"$body" >/dev/null; then
      echo "Expected an ErrorResponse for GET $path, got: $body" >&2
      exit 1
    fi
  done

  echo "Finished Successfully"
}

main "$@"
